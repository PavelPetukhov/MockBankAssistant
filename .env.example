# Model
MODEL_PROVIDER=gemini
GEMINI_API_KEY=

# Langfuse — defaults point at the local stack from `docker compose up`, whose project and
# keys are auto-provisioned on first boot. These are local-only dev keys, not real secrets.
# (Under `docker compose run agent` these are overridden to reach http://langfuse-web:3000.)
LANGFUSE_PUBLIC_KEY=pk-lf-mockbank-local
LANGFUSE_SECRET_KEY=sk-lf-mockbank-local
LANGFUSE_HOST=http://localhost:3000
# To use Langfuse Cloud instead: set the keys from your project and
# LANGFUSE_HOST=https://cloud.langfuse.com

# Vulnerability toggles (default off — turn on one at a time for red-team runs)
VULN_INDIRECT_INJECTION=false
VULN_EXCESSIVE_AGENCY=false
VULN_EXFIL=false
VULN_RAG_POISONING=false
VULN_SECRET_IN_PROMPT=false
VULN_MCP_TOOL_POISONING=false

# Defense toggles (default off)
DEFENSE_INPUT_FILTER=false
DEFENSE_OUTPUT_FILTER=false
DEFENSE_TRANSFER_CONFIRM=false
